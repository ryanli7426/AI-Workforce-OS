{
  "name": "ai-workforce-os",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first, human-governed AI workforce orchestration platform",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "^22.19.0 || ^24.0.0"
  },
  "packageManager": "pnpm@11.7.0",
  "bin": {
    "workforce": "./dist/cli/index.js"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "test": "pnpm build && vitest run",
    "build": "tsc -p tsconfig.json",
    "smoke": "node scripts/smoke.mjs",
    "check:dependencies": "node scripts/check-dependencies.mjs",
    "check": "pnpm typecheck && pnpm test && pnpm build && pnpm smoke && pnpm check:dependencies && pnpm web:typecheck && pnpm web:test && pnpm web:build && pnpm web:e2e",
    "workforce": "node dist/cli/index.js",
    "web:dev": "vite --config web/vite.config.ts",
    "web:build": "vite build --config web/vite.config.ts",
    "web:typecheck": "tsc -p web/tsconfig.json",
    "web:test": "vitest run --config web/vitest.config.ts",
    "web:e2e": "playwright test --config web/playwright.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.20.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "jsdom": "30.1.3",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "4.1.8"
  },
  "dependencies": {
    "@anthropic-ai/sandbox-runtime": "0.0.81",
    "@tanstack/react-query": "5.105.3",
    "fastify": "5.12.8",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  }
}
